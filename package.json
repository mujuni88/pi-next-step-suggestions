{
  "name": "pi-suggest",
  "version": "0.1.1",
  "description": "LLM-generated next-step suggestions for Pi autocomplete, chips, and picker UI.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "extension",
    "autocomplete",
    "suggestions"
  ],
  "license": "MIT",
  "files": [
    "README.md",
    "extensions"
  ],
  "homepage": "https://github.com/mujuni88/pi-suggest#readme",
  "bugs": {
    "url": "https://github.com/mujuni88/pi-suggest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujuni88/pi-suggest.git"
  },
  "pi": {
    "extensions": [
      "./extensions/next-step-suggestions.ts"
    ]
  },
  "scripts": {
    "test": "vitest run --pool=threads --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@mariozechner/pi-tui": "^0.73.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
