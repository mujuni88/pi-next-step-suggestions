{
  "name": "pi-next-step-suggestions",
  "version": "0.1.0",
  "description": "LLM-generated next-step suggestions for Pi autocomplete and picker UI.",
  "type": "module",
  "keywords": ["pi-package", "pi", "extension", "autocomplete", "suggestions"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujuni88/pi-next-step-suggestions.git"
  },
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "test": "vitest run --pool=threads --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@mariozechner/pi-tui": "^0.73.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
